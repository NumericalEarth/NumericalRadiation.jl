44dcddf099d69becab1c5e6674d013d6c676685e0b8a4ae51e85a1dda33cfc69  $RUNROOT/test-template/config.h
34323fd3ecbcd64980b328eec463eedc692497ed3cdd685f2505ca4d1fdc5e2c  $RUNROOT/test-template/check_configuration.h
