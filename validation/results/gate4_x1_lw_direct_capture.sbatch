g++ -std=c++11 -o "$RUNROOT/tools/x1_alias_probe" "$RUNROOT/tools/x1_alias_probe.cpp" -I/shared/home/greg/local/adept-2-install/include -L/shared/home/greg/local/adept-2-install/lib -Wl,-rpath,/shared/home/greg/local/adept-2-install/lib -ladept || { echo "REFUSED: alias probe failed to compile" >&2; exit 68; }
