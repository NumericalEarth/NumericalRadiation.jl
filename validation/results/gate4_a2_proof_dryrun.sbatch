#!/bin/bash
#SBATCH --job-name=g4-a2-proof-create-lut
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-a2-proof-%j.log
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 A2 reproduction proof: raw create_lut builds ONLY (no optimisation,
# no scaling, no objective stages). Generated by
# gate4_a2_proof_driver_checkpoint.jl; DO NOT run outside Slurm.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

TESTCOPY=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/testcopy

echo "=== proof stage 0: environment + candidate identity checks ==="
test -d "$TESTCOPY" || { echo "REFUSED: 4082 TESTCOPY missing" >&2; exit 68; }
grep -q '^CKDMIP_DATA_DIR=/shared/home/greg/data/ckdmip$' "$TESTCOPY/config.h" || { echo "BAD config: CKDMIP_DATA_DIR" >&2; exit 68; }
grep -q '^WORK_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work$' "$TESTCOPY/config.h" || { echo "BAD config: WORK_DIR" >&2; exit 68; }
grep -q '^BINDIR=/shared/home/greg/ecckd-derived-flux-work/ecckd/src/ecckd$' "$TESTCOPY/config.h" || { echo "BAD config: BINDIR" >&2; exit 68; }
grep -q '^MMM_SW_SPECTRA_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/input/mmm/sw_spectra$' "$TESTCOPY/config.h" || { echo "BAD config: MMM_SW_SPECTRA_DIR" >&2; exit 68; }
grep -q '^CLOUD_SPECTRUM=/shared/home/greg/ecckd-derived-flux-work/ecckd/data/mie_droplet_scattering.nc$' "$TESTCOPY/config.h" || { echo "BAD config: CLOUD_SPECTRUM" >&2; exit 68; }
sha256sum -c <<'HASHES' || { echo "REFUSED: candidate hash mismatch vs 4082 ledger" >&2; exit 69; }
c96e64927c4d0d706d35f376be59f17517dae6d6d7041d0791d164641a017a3e  /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_gpoints/ecckd-1.2_lw_gpoints_climate_fsck-tol0.0161.h5
13dd686acd0c3ca2201775270f876ce3e3a326576b58b24323b5ce95659b9b57  /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_gpoints/ecckd-1.2_sw_gpoints_climate_rgb-tol0.047.h5
HASHES
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_raw-ckd-definition/ecckd-1.2_lw_raw-ckd-definition_climate_fsck-tol0.0161.nc" || { echo "REFUSED: stale LW raw output already exists; the authorized proof run must CREATE it, not inherit it" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_raw-ckd-definition/ecckd-1.2_sw_raw-ckd-definition_climate_rgb-tol0.047.nc" || { echo "REFUSED: stale SW raw output already exists; the authorized proof run must CREATE it, not inherit it" >&2; exit 70; }
test -d "/shared/home/greg/data/ckdmip/idealized/lw_spectra" || { echo "MISSING idealized LW spectra" >&2; exit 65; }
test -d "/shared/home/greg/data/ckdmip/idealized/sw_spectra" || { echo "MISSING idealized SW spectra" >&2; exit 65; }
test -s "/shared/home/greg/data/ckdmip/mmm/conc/ckdmip_mmm-const_concentrations.nc" || { echo "MISSING mmm-const conc" >&2; exit 65; }
test -s "/shared/home/greg/data/ckdmip/mmm/sw_spectra_extras/ckdmip_ssi.h5" || { echo "MISSING MMM SSI" >&2; exit 65; }
cd "$TESTCOPY"

echo "=== proof LW: raw create_lut (fsck, TOLERANCE=0.0161) ==="
APPLICATION=climate BAND_STRUCTURE=fsck TOLERANCE=0.0161 bash create_lut_lw.sh
echo "=== proof SW: raw create_lut (rgb, TOLERANCE=0.047) ==="
APPLICATION=climate BAND_STRUCTURE=rgb TOLERANCE=0.047 bash create_lut_sw.sh

echo "=== proof raw outputs ==="
sha256sum "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_raw-ckd-definition/ecckd-1.2_lw_raw-ckd-definition_climate_fsck-tol0.0161.nc" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_raw-ckd-definition/ecckd-1.2_sw_raw-ckd-definition_climate_rgb-tol0.047.nc"
echo "=== proof create_lut done rc=$? $(date -u +%FT%TZ) ==="
