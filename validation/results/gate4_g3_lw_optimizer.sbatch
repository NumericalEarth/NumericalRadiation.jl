#!/bin/bash
#SBATCH --job-name=g4-g3-lw-optimizer
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-g3-lw-%j.log
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=36
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 G3 LW staged optimizer: optimize_lut ONLY (no
# create/scale/find/LBL stages). Generated by gate4_g3_executor_checkpoint.jl.
# Faithful TRAINING_BOTH=yes recovery run from the accepted init.
# RESTARTABLE BY DESIGN: every intermediate lives under the job-private
# RUNROOT (validated numeric SLURM_JOB_ID); only the FINAL ckd file is
# published -- atomically -- to the canonical path, so a TIMEOUT can be
# resubmitted without any deletion. RUNROOT is preserved on success AND
# failure for ledger/forensics; no recursive deletion anywhere.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi
case "$SLURM_JOB_ID" in
    ''|*[!0-9]*) echo "REFUSED: SLURM_JOB_ID is not a positive integer" >&2; exit 64;;
esac

G4WORK=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation
RUNROOT="$G4WORK/g3-runs/${SLURM_JOB_ID}/lw"
WRAPPER="$RUNROOT/tools/optimize_lut_h5preinit_v12"
TESTCOPY="$RUNROOT/testcopy"
STAGED_FINAL="$RUNROOT/work/lw_ckd-definition/ecckd-1.2_lw_ckd-definition_climate_fsck-tol0.0161.nc"
CANON_FINAL="/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_ckd-definition/ecckd-1.2_lw_ckd-definition_climate_fsck-tol0.0161.nc"

echo "=== G3-lw stage 0a: gate-code identity (verify BEFORE sourcing) ==="
sha256sum -c <<'GATEPINS' || { echo "REFUSED: gate code changed since generation; regenerate the checkpoint" >&2; exit 75; }
e31e57f0446d3396ba86644f3aefd88284231c507feaba305160c97788fae664  /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/gate4_quota_guard.sh
d06d1608152303cbf6bf73794447bbf59cf8deb40a5baf26a0231984cf93fc71  /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/gate4_g3_scoped_input_preflight.jl
75eafc929232b6bb11f7baad3e52d8769290c80984c33904ecf4a748a110ea05  /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/gate4_g3_executor_checkpoint.jl
60fbaa93cf5f7e34eac2fcf6e054ae4caaf99c2e4e0a63a6c74aa74eeff31d12  /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/validation_results.jl
9136a5f68b97123017182b5afaf30c93148188a0ea8681ac3d17a808f6012ef0  /shared/home/greg/Projects/AnalyticBandRadiation-platform/test/Project.toml
cf9f318d43221280a8ca1116fbfea20d66678267f4e9d5dd1bdf519093ceb186  /shared/home/greg/Projects/AnalyticBandRadiation-platform/test/Manifest.toml
GATEPINS

echo "=== G3-lw stage 0b: quota health (read-only; before controlled optimizer workspace/output allocation) ==="
source /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/gate4_quota_guard.sh
quota_health $((5*1024*1024*1024)) || { echo "REFUSED: quota not healthy (soft-primary reserve shortfall or unhealthy state)" >&2; exit 67; }

echo "=== G3-lw stage 0c: fresh scoped preflight must be READY (no-write mode; full diagnostics preserved) ==="
set +e
PF_OUT=$(cd /shared/home/greg/Projects/AnalyticBandRadiation-platform && G3_PREFLIGHT_CHECK_ONLY=1 julia --project=test validation/gate4_g3_scoped_input_preflight.jl 2>&1)
PF_RC=$?
set -e
echo "$PF_OUT"
[ "$PF_RC" = 0 ] || { echo "REFUSED: scoped preflight exited rc=$PF_RC at execution time (diagnostics above)" >&2; exit 74; }
[ "$(printf '%s\n' "$PF_OUT" | grep -c '^gate4_g3_scoped_input_preflight: g3_scoped_preflight_ready$')" = 1 ] || { echo "REFUSED: scoped preflight did not report exactly one exact READY status line" >&2; exit 74; }

echo "=== G3-lw stage 0d: band lock (acquired before campaign RUNROOT/input-snapshot/output mutation) ==="
mkdir -p "$G4WORK/locks"
exec 9>"$G4WORK/locks/g3-lw.lock"
flock -n 9 || { echo "REFUSED: another G3-lw job holds the lock" >&2; exit 73; }

echo "=== G3-lw stage 0e: exact size+sha pin of EVERY optimizer input (originals) ==="
sha256sum -c <<'HASHES' || { echo "REFUSED: pinned input/source hash mismatch" >&2; exit 69; }
