#!/bin/bash
#SBATCH --job-name=g4-g2c-eval2-fetch
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-g2c-%j.log
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --partition=cpu-large

# Gate-4 G2c: evaluation2 spectra fetch ONLY (no LBL, no optimizer, no
# create/scale/find stages). Generated by gate4_g2c_eval2_fetch_checkpoint.jl.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

DEST=/shared/home/greg/data/ckdmip/evaluation2

echo "=== G2c stage 0: preflight ==="
command -v aws >/dev/null || { echo "MISSING aws CLI on compute node" >&2; exit 65; }
aws sts get-caller-identity >/dev/null || { echo "REFUSED: AWS auth unavailable (SSO expired?)" >&2; exit 66; }
avail_kb=$(df --output=avail /shared | tail -1)
[ "$avail_kb" -gt 419430400 ] || { echo "REFUSED: <400GB free on /shared" >&2; exit 67; }
# uid-quota headroom guard (job 4440 lesson: df cannot see Lustre uid
# quotas). Audited selected-source total: 329,989,234,896 B; margin 40 GiB.
source /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/gate4_quota_guard.sh
quota_guard "$DEST" "/shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/gate4_eval2_selected_manifest.tsv" $((40*1024*1024*1024)) || { echo "REFUSED: quota headroom insufficient" >&2; exit 67; }
mkdir -p "$DEST/lw_spectra" "$DEST/sw_spectra"

echo "=== G2c stage 1: sync LW spectra (7 species x 5 chunks, ~220 GB) ==="
aws s3 sync "s3://aeolus-dev/users/greg@aeolus.earth/ckdmip/evaluation2/lw_spectra/" "$DEST/lw_spectra/" \
  --exclude "*" --include "ckdmip_evaluation2_lw_spectra_h2o_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_o3_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_co2_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_ch4_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_n2o_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_n2_constant_*.h5" --include "ckdmip_evaluation2_lw_spectra_o2_constant_*.h5" --no-progress
echo "=== G2c stage 2: sync SW spectra (7 species x 5 chunks, ~110 GB) ==="
aws s3 sync "s3://aeolus-dev/users/greg@aeolus.earth/ckdmip/evaluation2/sw_spectra/" "$DEST/sw_spectra/" \
  --exclude "*" --include "ckdmip_evaluation2_sw_spectra_h2o_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_o3_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_co2_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_ch4_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_n2o_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_n2_constant_*.h5" --include "ckdmip_evaluation2_sw_spectra_o2_constant_*.h5" --no-progress

echo "=== G2c stage 3: exact-70 completeness + size verification ==="
MISSING=0
for band in lw sw; do
    for sp in h2o_present o3_present co2_present ch4_present n2o_present n2_constant o2_constant; do
        for chunk in 1-10 11-20 21-30 31-40 41-50; do
            f="$DEST/${band}_spectra/ckdmip_evaluation2_${band}_spectra_${sp}_${chunk}.h5"
            [ -s "$f" ] || { echo "MISSING $f" >&2; MISSING=1; }
        done
    done
done
[ "$MISSING" = 0 ] || { echo "REFUSED: completeness gate failed" >&2; exit 71; }
# re-run sync as identity check: any transfer line means a size/mtime
# mismatch survived stage 1-2 (sync copies only on mismatch, so a clean
# second pass proves local == S3 for every included file)
RESYNC=$(aws s3 sync "s3://aeolus-dev/users/greg@aeolus.earth/ckdmip/evaluation2/lw_spectra/" "$DEST/lw_spectra/" --exclude "*" --include "ckdmip_evaluation2_lw_spectra_h2o_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_o3_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_co2_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_ch4_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_n2o_present_*.h5" --include "ckdmip_evaluation2_lw_spectra_n2_constant_*.h5" --include "ckdmip_evaluation2_lw_spectra_o2_constant_*.h5" --no-progress 2>&1 | head -5)
RESYNC2=$(aws s3 sync "s3://aeolus-dev/users/greg@aeolus.earth/ckdmip/evaluation2/sw_spectra/" "$DEST/sw_spectra/" --exclude "*" --include "ckdmip_evaluation2_sw_spectra_h2o_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_o3_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_co2_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_ch4_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_n2o_present_*.h5" --include "ckdmip_evaluation2_sw_spectra_n2_constant_*.h5" --include "ckdmip_evaluation2_sw_spectra_o2_constant_*.h5" --no-progress 2>&1 | head -5)
[ -z "$RESYNC$RESYNC2" ] || { echo "REFUSED: resync transferred data (mismatch): $RESYNC $RESYNC2" >&2; exit 72; }

echo "=== G2c outputs ==="
echo "lw files: $(ls "$DEST/lw_spectra/" | wc -l)  bytes: $(du -sb "$DEST/lw_spectra" | cut -f1)"
echo "sw files: $(ls "$DEST/sw_spectra/" | wc -l)  bytes: $(du -sb "$DEST/sw_spectra" | cut -f1)"
echo "=== G2c done rc=$? $(date -u +%FT%TZ) ==="
