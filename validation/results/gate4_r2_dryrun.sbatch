#!/bin/bash
#SBATCH --job-name=g4-r2-v14-sw-proof
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-r2-%j.log
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 R2: build ecCKD v1.4 (23adaca) + SW raw create_lut proof ONLY (no
# find_g_points, no optimisation, no objective stages). Generated by
# gate4_r2_execution_checkpoint.jl under Greg's R2 authorization.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

V14=/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca
G4WORK=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation

echo "=== R2 stage 0: tree/commit/candidate checks ==="
test -d "$V14" || { echo "REFUSED: v1.4 tree missing" >&2; exit 68; }
test "$(git -C "$V14" rev-parse HEAD)" = "23adaca3344f4b53f109f3bd9533a5ed62998ec0" || { echo "REFUSED: v1.4 tree not at 23adaca" >&2; exit 68; }
grep -q 'AC_INIT(\[ecCKD\], \[1.4\]' "$V14/configure.ac" || { echo "REFUSED: configure.ac not 1.4" >&2; exit 68; }
sha256sum -c <<'HASHES' || { echo "REFUSED: SW candidate hash mismatch vs 4082 ledger" >&2; exit 69; }
13dd686acd0c3ca2201775270f876ce3e3a326576b58b24323b5ce95659b9b57  /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_gpoints/ecckd-1.2_sw_gpoints_climate_rgb-tol0.047.h5
HASHES
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw-ckd-definition_climate_rgb-tol0.047.nc" || { echo "REFUSED: stale v1.4 SW raw output already exists" >&2; exit 70; }
test -d "/shared/home/greg/data/ckdmip/idealized/sw_spectra" || { echo "MISSING idealized SW spectra" >&2; exit 65; }
test -s "/shared/home/greg/data/ckdmip/mmm/conc/ckdmip_mmm-const_concentrations.nc" || { echo "MISSING mmm-const conc" >&2; exit 65; }
test -s "/shared/home/greg/data/ckdmip/mmm/sw_spectra_extras/ckdmip_ssi.h5" || { echo "MISSING MMM SSI" >&2; exit 65; }

echo "=== R2 stage 1: build v1.4 (toolchain parity with pinned v1.2 build) ==="
# LIBS=-ladept works around an upstream m4 ordering bug exposed at v1.4:
# adept.m4 puts -ladept in LDFLAGS (before the conftest object), which
# Ubuntu's --as-needed linker drops; v1.2's weaker Adept>=1.1 conftest was
# header-only satisfiable so the bug was latent there. LIBS is placed after
# the object by autoconf/automake, resolving adept::compiler_version().
# Attempt 1 (job 4094) failed at exactly this configure check.
# LIBS applies to EVERY conftest incl. the initial compiler sanity check,
# which runs before --with-adept adds any -L path -- so the adept lib dir
# must also be in user LDFLAGS (attempt 2, job 4095, failed there with
# "C++ compiler cannot create executables" / cannot find -ladept).
cd "$V14"
if [ ! -x src/ecckd/create_look_up_table ]; then
    [ -x ./configure ] || autoreconf -i
    ./configure --with-adept=/shared/home/greg/local/adept-2-install --with-netcdf=/shared/home/greg/local/ckdmip-stack \
        LDFLAGS="-L/shared/home/greg/local/adept-2-install/lib -Wl,-rpath,/shared/home/greg/local/adept-2-install/lib" LIBS=-ladept
    make -j16
fi
echo "build provenance:"
gcc --version | head -1
git -C "$V14" rev-parse HEAD
sha256sum src/ecckd/create_look_up_table

echo "=== R2 stage 2: isolated testcopy-v14 (pinned v1.2 workcopy untouched) ==="
TESTCOPY="$G4WORK/testcopy-v14"
rm -rf "$TESTCOPY"
cp -r "$V14/test" "$TESTCOPY"
sed -i \
  -e 's|^CKDMIP_DATA_DIR=.*|CKDMIP_DATA_DIR=/shared/home/greg/data/ckdmip|' \
  -e 's|^WORK_DIR=.*|WORK_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14|' \
  -e 's|^BINDIR=.*|BINDIR=/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/src/ecckd|' \
  -e 's|^MMM_SW_SPECTRA_DIR=.*|MMM_SW_SPECTRA_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/input/mmm/sw_spectra|' \
  -e 's|^CLOUD_SPECTRUM=.*|CLOUD_SPECTRUM=/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/data/mie_droplet_scattering.nc|' \
  "$TESTCOPY/config.h"
grep -E "^(CKDMIP_DATA_DIR|WORK_DIR|BINDIR|MMM_SW_SPECTRA_DIR|CLOUD_SPECTRUM)=" "$TESTCOPY/config.h"

echo "=== R2 stage 3: mechanism-1 candidate placement under v1.4 name ==="
mkdir -p "$G4WORK/work-v14/sw_gpoints"
ln -sf "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_gpoints/ecckd-1.2_sw_gpoints_climate_rgb-tol0.047.h5" "$G4WORK/work-v14/sw_gpoints/ecckd-1.4_sw_gpoints_climate_rgb-tol0.047.h5"
ls -la "$G4WORK/work-v14/sw_gpoints/"

echo "=== R2 stage 4: SW raw create_lut (rgb, TOLERANCE=0.047) ==="
cd "$TESTCOPY"
APPLICATION=climate BAND_STRUCTURE=rgb TOLERANCE=0.047 bash create_lut_sw.sh

echo "=== R2 outputs ==="
sha256sum "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw-ckd-definition_climate_rgb-tol0.047.nc"
echo "=== R2 done rc=$? $(date -u +%FT%TZ) ==="
