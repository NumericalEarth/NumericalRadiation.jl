#!/bin/bash
#SBATCH --job-name=g4-g2b-sw-rgb-minor
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-g2b-%j.log
#SBATCH --time=16:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 G2b: RGB-banded SW LBL training fluxes, minor-gas + present
# scenarios ONLY (no optimizer, no create/scale/find_g_points stages).
# Generated by gate4_g2b_sw_rgb_variants_checkpoint.jl.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

G4WORK=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation
TESTCOPY="$G4WORK/testcopy-rgb-g2b"
WORKRGB="$G4WORK/work-rgb-g2b"
SCEN="present ch4-350 ch4-700 ch4-1200 ch4-2600 ch4-3500 n2o-190 n2o-270 n2o-405 n2o-540"

echo "=== G2b stage 0: preflight ==="
test -x "/shared/home/greg/build/ckdmip-1.0/bin/ckdmip_sw" || { echo "MISSING ckdmip_sw" >&2; exit 65; }
test -s "/shared/home/greg/data/ckdmip/evaluation1/sw_spectra/ckdmip_ssi.h5" || { echo "MISSING evaluation1 SSI" >&2; exit 65; }
for chunk in 1-10 11-20 21-30 31-40 41-50; do
    for gas in h2o o3 co2 ch4 n2o o2 n2 rayleigh; do
        ls "/shared/home/greg/data/ckdmip/evaluation1/sw_spectra/"ckdmip_evaluation1_sw_spectra_${gas}_*_${chunk}.h5 >/dev/null 2>&1 || { echo "MISSING evaluation1 SW spectra: $gas $chunk" >&2; exit 65; }
    done
done
for scen in $SCEN; do
    test ! -e "$WORKRGB/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5" || { echo "REFUSED: stale consolidated rgb output $scen" >&2; exit 70; }
    test ! -e "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5" || { echo "REFUSED: stale installed rgb output $scen" >&2; exit 70; }
done
# partial-RAW guard (job 4103 was canceled mid-run and left header-size RAW
# chunks): run_sw_lbl_evaluation reuses nonempty RAW files, so the whole
# quarantine work dir is wiped for a clean regeneration. Under Slurm only;
# operates solely on the G2b quarantine tree, never the G2a work-rgb or any
# installed data.
if [ -e "$WORKRGB" ]; then
    echo "clearing pre-existing G2b quarantine (partial RAW guard): $WORKRGB"
    find "$WORKRGB" -name 'RAW_ckdmip_evaluation1_sw_fluxes-rgb_*.h5' -printf '  partial: %p (%s B)\n' 2>/dev/null || true
    rm -rf "$WORKRGB"
fi

echo "=== G2b stage 1: isolated testcopy-rgb-g2b from the PINNED artifact ==="
rm -rf "$TESTCOPY"
cp -r "/shared/home/greg/.julia/artifacts/7b210aef53e908cfe3c709945f0763c37ca82aaa/ecckd-6115f9b8e29a55cb0f48916857bdc77fec41badd/test" "$TESTCOPY"
cd "$TESTCOPY"
sed 's/@PACKAGE_VERSION@/1.2/g' version.h.in > version.h
sed -i \
  -e 's|^CKDMIP_DIR=.*|CKDMIP_DIR=/shared/home/greg/build/ckdmip-1.0|' \
  -e 's|^CKDMIP_DATA_DIR=.*|CKDMIP_DATA_DIR=/shared/home/greg/data/ckdmip|' \
  -e 's|^WORK_DIR=.*|WORK_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-rgb-g2b|' \
  -e 's|^BINDIR=.*|BINDIR=/shared/home/greg/ecckd-derived-flux-work/ecckd/src/ecckd|' \
  config.h
grep -E "^(CKDMIP_DIR|CKDMIP_DATA_DIR|WORK_DIR|BINDIR)=" config.h
# scenario override: replace the default rel-list with the G2b minor set
sed -i -E "0,/^SCENARIOS=\"[^\"]*\"/s||SCENARIOS=\"$SCEN\"|" run_sw_lbl_evaluation.sh
grep -E "^SCENARIOS=" run_sw_lbl_evaluation.sh
grep -qE "^SCENARIOS=\"present ch4-350" run_sw_lbl_evaluation.sh || { echo "BAD edit: SCENARIOS" >&2; exit 68; }
# band-structure edits (identical to G2a): fluxes -> fluxes-rgb; 13-band off;
# 9-band 14300-variant on
sed -i \
  -e 's|^BANDCODE=fluxes$|BANDCODE=fluxes-rgb|' \
  -e 's|^band_wavenumber1(1:13)|!band_wavenumber1(1:13)|' \
  -e 's|^band_wavenumber2(1:13)|!band_wavenumber2(1:13)|' \
  -e 's|^!band_wavenumber1(1:9) = 250, 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750,|band_wavenumber1(1:9) = 250, 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750,|' \
  -e 's|^!band_wavenumber2(1:9) = 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750, 50000,|band_wavenumber2(1:9) = 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750, 50000,|' \
  run_sw_lbl_evaluation.sh
grep -E "^BANDCODE=|^band_wavenumber" run_sw_lbl_evaluation.sh
grep -qE "^BANDCODE=fluxes-rgb$" run_sw_lbl_evaluation.sh || { echo "BAD edit: BANDCODE" >&2; exit 68; }
test $(grep -cE "^band_wavenumber1" run_sw_lbl_evaluation.sh) -eq 1 || { echo "BAD edit: band grid count" >&2; exit 68; }
# pipeline parity with 4078/G2a
sed -i '/^module load nco$/s/^/# /' run_sw_lbl_evaluation.sh
sed -i 's/iverbose = 3/iverbose = 1/g' run_sw_lbl_evaluation.sh
sed -i -E 's|ncrcat -O \$OUTFILES \$OUTFILE|julia --project=/shared/home/greg/Projects/AnalyticBandRadiation-platform/test /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/concat_ckdmip_flux_chunks.jl $OUTFILES $OUTFILE|' run_sw_lbl_evaluation.sh
sed -i '/OUTFILES="$OUTFILES $OUTFILE"/a\
\tif [ -s "$OUTFILE" ]\
\tthen\
\t    echo "*** REUSING $OUTFILE ***"\
\t    continue\
\tfi' run_sw_lbl_evaluation.sh

echo "=== G2b stage 2: RGB-banded SW LBL evaluation (10 minor+present) ==="
bash run_sw_lbl_evaluation.sh

echo "=== G2b stage 3: exact-10 completeness gate + install ==="
ALL_OK=1
for scen in $SCEN; do
    test -s "$G4WORK/work-rgb-g2b/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5" || { echo "MISSING consolidated rgb $scen" >&2; ALL_OK=0; }
done
[ "$ALL_OK" = 1 ] || { echo "REFUSED: completeness gate failed; NOT installing partial set" >&2; exit 71; }
mkdir -p "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb"
for scen in $SCEN; do
    install -m 0644 "$G4WORK/work-rgb-g2b/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5" "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/"
    cmp -s "$G4WORK/work-rgb-g2b/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5" "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5" || { echo "INSTALL IDENTITY MISMATCH $scen" >&2; exit 72; }
done

echo "=== G2b outputs ==="
for scen in $SCEN; do
    sha256sum "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/ckdmip_evaluation1_sw_fluxes-rgb_$scen.h5"
done
echo "=== G2b done rc=$? $(date -u +%FT%TZ) ==="
