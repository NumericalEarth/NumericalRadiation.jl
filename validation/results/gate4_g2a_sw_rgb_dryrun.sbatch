#!/bin/bash
#SBATCH --job-name=g4-g2a-sw-rgb-fluxes
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-g2a-%j.log
#SBATCH --time=10:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 G2a: RGB-banded SW LBL training fluxes, rel scenarios ONLY (no
# optimizer, no objective stages). Generated by
# gate4_g2a_sw_rgb_flux_checkpoint.jl.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

G4WORK=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation
TESTCOPY="$G4WORK/testcopy-rgb"

echo "=== G2a stage 0: preflight ==="
test -x "/shared/home/greg/build/ckdmip-1.0/bin/ckdmip_sw" || { echo "MISSING ckdmip_sw" >&2; exit 65; }
test -s "/shared/home/greg/data/ckdmip/evaluation1/sw_spectra/ckdmip_ssi.h5" || { echo "MISSING evaluation1 SSI" >&2; exit 65; }
for chunk in 1-10 11-20 21-30 31-40 41-50; do
    for gas in h2o o3 co2 ch4 n2o o2 n2 rayleigh; do
        ls "/shared/home/greg/data/ckdmip/evaluation1/sw_spectra/"ckdmip_evaluation1_sw_spectra_${gas}_*_${chunk}.h5 >/dev/null 2>&1 || { echo "MISSING evaluation1 SW spectra: $gas $chunk" >&2; exit 65; }
    done
done
for lev in 180 280 415 560 1120 2240; do
    test ! -e "$G4WORK/work-rgb/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_rel-$lev.h5" || { echo "REFUSED: stale consolidated rgb output rel-$lev" >&2; exit 70; }
    test ! -e "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/ckdmip_evaluation1_sw_fluxes-rgb_rel-$lev.h5" || { echo "REFUSED: stale installed rgb output rel-$lev" >&2; exit 70; }
done

echo "=== G2a stage 1: isolated testcopy-rgb from the PINNED artifact ==="
rm -rf "$TESTCOPY"
cp -r "/shared/home/greg/.julia/artifacts/7b210aef53e908cfe3c709945f0763c37ca82aaa/ecckd-6115f9b8e29a55cb0f48916857bdc77fec41badd/test" "$TESTCOPY"
cd "$TESTCOPY"
sed 's/@PACKAGE_VERSION@/1.2/g' version.h.in > version.h
sed -i \
  -e 's|^CKDMIP_DIR=.*|CKDMIP_DIR=/shared/home/greg/build/ckdmip-1.0|' \
  -e 's|^CKDMIP_DATA_DIR=.*|CKDMIP_DATA_DIR=/shared/home/greg/data/ckdmip|' \
  -e 's|^WORK_DIR=.*|WORK_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-rgb|' \
  -e 's|^BINDIR=.*|BINDIR=/shared/home/greg/ecckd-derived-flux-work/ecckd/src/ecckd|' \
  config.h
grep -E "^(CKDMIP_DIR|CKDMIP_DATA_DIR|WORK_DIR|BINDIR)=" config.h
# band-structure edits: fluxes -> fluxes-rgb; deactivate the 13-band narrow
# grid; activate the 9-band RGB grid (14300/16650/20000/25000/31750 variant)
sed -i \
  -e 's|^BANDCODE=fluxes$|BANDCODE=fluxes-rgb|' \
  -e 's|^band_wavenumber1(1:13)|!band_wavenumber1(1:13)|' \
  -e 's|^band_wavenumber2(1:13)|!band_wavenumber2(1:13)|' \
  -e 's|^!band_wavenumber1(1:9) = 250, 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750,|band_wavenumber1(1:9) = 250, 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750,|' \
  -e 's|^!band_wavenumber2(1:9) = 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750, 50000,|band_wavenumber2(1:9) = 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750, 50000,|' \
  run_sw_lbl_evaluation.sh
grep -E "^BANDCODE=|^band_wavenumber" run_sw_lbl_evaluation.sh
grep -qE "^BANDCODE=fluxes-rgb$" run_sw_lbl_evaluation.sh || { echo "BAD edit: BANDCODE" >&2; exit 68; }
test $(grep -cE "^band_wavenumber1" run_sw_lbl_evaluation.sh) -eq 1 || { echo "BAD edit: band grid count" >&2; exit 68; }
# pipeline parity with 4078: no nco module, quieter, Julia concat, reuse-skip
sed -i '/^module load nco$/s/^/# /' run_sw_lbl_evaluation.sh
sed -i 's/iverbose = 3/iverbose = 1/g' run_sw_lbl_evaluation.sh
sed -i -E 's|ncrcat -O \$OUTFILES \$OUTFILE|julia --project=/shared/home/greg/Projects/AnalyticBandRadiation-platform/test /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/concat_ckdmip_flux_chunks.jl $OUTFILES $OUTFILE|' run_sw_lbl_evaluation.sh
sed -i '/OUTFILES="$OUTFILES $OUTFILE"/a\
\tif [ -s "$OUTFILE" ]\
\tthen\
\t    echo "*** REUSING $OUTFILE ***"\
\t    continue\
\tfi' run_sw_lbl_evaluation.sh

echo "=== G2a stage 2: RGB-banded SW LBL evaluation (6 rel scenarios) ==="
bash run_sw_lbl_evaluation.sh

echo "=== G2a stage 3: exact-6 completeness gate + install ==="
ALL_OK=1
for lev in 180 280 415 560 1120 2240; do
    test -s "$G4WORK/work-rgb/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_rel-$lev.h5" || { echo "MISSING consolidated rgb rel-$lev" >&2; ALL_OK=0; }
done
[ "$ALL_OK" = 1 ] || { echo "REFUSED: completeness gate failed; NOT installing partial set" >&2; exit 71; }
mkdir -p "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb"
for lev in 180 280 415 560 1120 2240; do
    install -m 0644 "$G4WORK/work-rgb/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_rel-$lev.h5" "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/"
    cmp -s "$G4WORK/work-rgb/sw_lbl_fluxes/ckdmip_evaluation1_sw_fluxes-rgb_rel-$lev.h5" "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/ckdmip_evaluation1_sw_fluxes-rgb_rel-$lev.h5" || { echo "INSTALL IDENTITY MISMATCH rel-$lev" >&2; exit 72; }
done

echo "=== G2a outputs ==="
sha256sum "/shared/home/greg/data/ckdmip/evaluation1/sw_fluxes-rgb/"ckdmip_evaluation1_sw_fluxes-rgb_rel-*.h5
echo "=== G2a done rc=$? $(date -u +%FT%TZ) ==="
