#!/bin/bash
#SBATCH --job-name=g4-g3-sw-optimizer
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-g3-sw-%j.log
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=36
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 G3 SW staged optimizer: optimize_lut ONLY (no
# create/scale/find/LBL stages). Generated by gate4_g3_executor_checkpoint.jl.
# Faithful TRAINING_BOTH=yes recovery run from the accepted init.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

G4WORK=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation
TESTCOPY="$G4WORK/testcopy-g3-sw"

echo "=== G3-sw stage 0: input identity checks ==="
sha256sum -c <<'HASHES' || { echo "REFUSED: pinned input hash mismatch" >&2; exit 69; }
74d8be65226f081f3d2882520ab374ed102d73cc3dd43bb2fa7c5a5c27602d74  /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_scaled-ckd-definition_climate_rgb-tol0.047.nc
101e41ed77c83c81c138494a2b950bbffd12caad27b0c64028666550d7c30d65  /shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/src/ecckd/optimize_lut
28003281a7f1c8470c1bfd94a654999a210581261a5c3e9cd662af2a13dd492f  /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/tools/h5open_before_traps.so
HASHES
test -x "/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/src/ecckd/optimize_lut" || { echo "REFUSED: optimize_lut not executable" >&2; exit 68; }
test -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "REFUSED: eval2 TRAINING_BOTH file missing (G2d incomplete)" >&2; exit 65; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw2-ckd-definition_climate_rgb-tol0.047.nc" || { echo "REFUSED: stale optimizer output exists: /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw2-ckd-definition_climate_rgb-tol0.047.nc" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw3-ckd-definition_climate_rgb-tol0.047.nc" || { echo "REFUSED: stale optimizer output exists: /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw3-ckd-definition_climate_rgb-tol0.047.nc" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_ckd-definition/ecckd-1.4_sw_ckd-definition_climate_rgb-tol0.047.nc" || { echo "REFUSED: stale optimizer output exists: /shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_ckd-definition/ecckd-1.4_sw_ckd-definition_climate_rgb-tol0.047.nc" >&2; exit 70; }

echo "=== G3-sw stage 1: optimizer wrapper (FP-trap shim; env-only) ==="
mkdir -p "$G4WORK/tools"
cat > "$G4WORK/tools/optimize_lut_h5preinit_v14" <<WRAP
#!/bin/bash
export LD_PRELOAD="/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/tools/h5open_before_traps.so"
exec "/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/src/ecckd/optimize_lut" "\$@"
WRAP
chmod +x "$G4WORK/tools/optimize_lut_h5preinit_v14"
sha256sum "$G4WORK/tools/optimize_lut_h5preinit_v14"

echo "=== G3-sw stage 2: isolated testcopy (config overrides) ==="
rm -rf "$TESTCOPY"
cp -r "/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/test" "$TESTCOPY"
cd "$TESTCOPY"
sed 's/@PACKAGE_VERSION@/1.4/g' version.h.in > version.h
sed -i \
  -e 's|^CKDMIP_DIR=.*|CKDMIP_DIR=/shared/home/greg/build/ckdmip-1.0|' \
  -e 's|^CKDMIP_DATA_DIR=.*|CKDMIP_DATA_DIR=/shared/home/greg/data/ckdmip|' \
  -e 's|^WORK_DIR=.*|WORK_DIR=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14|' \
  -e 's|^BINDIR=.*|BINDIR=/shared/home/greg/ecckd-derived-flux-work/ecckd-v1.4-23adaca/src/ecckd|' \
  -e 's|^TRAINING_BOTH=no$|TRAINING_BOTH=yes|' \
  -e 's|^OPTIMIZE_LUT=.*|OPTIMIZE_LUT=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/tools/optimize_lut_h5preinit_v14|' \
  config.h
grep -E "^(CKDMIP_DIR|CKDMIP_DATA_DIR|WORK_DIR|BINDIR|TRAINING_BOTH|OPTIMIZE_LUT)=" config.h
grep -qE "^TRAINING_BOTH=yes$" config.h || { echo "BAD config: TRAINING_BOTH" >&2; exit 68; }

echo "=== G3-sw stage 3: staged optimizer (relative-base relative-ch4 relative-n2o) ==="
APPLICATION=climate BAND_STRUCTURE=rgb TOLERANCE=0.047 \
    bash optimize_lut_sw.sh relative-base relative-ch4 relative-n2o

echo "=== G3-sw outputs ==="
sha256sum "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw2-ckd-definition_climate_rgb-tol0.047.nc" \
    "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_raw-ckd-definition/ecckd-1.4_sw_raw3-ckd-definition_climate_rgb-tol0.047.nc" \
    "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_ckd-definition/ecckd-1.4_sw_ckd-definition_climate_rgb-tol0.047.nc"
test -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_ckd-definition/ecckd-1.4_sw_ckd-definition_climate_rgb-tol0.047.nc" || { echo "MISSING final ckd-definition" >&2; exit 71; }
echo "=== G3-sw done rc=$? $(date -u +%FT%TZ) ==="
