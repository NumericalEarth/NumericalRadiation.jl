#!/bin/bash
#SBATCH --job-name=g4-g2d-eval2-rel415
#SBATCH --output=/shared/home/greg/data/ckdmip-logs/g4-g2d-%j.log
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
#SBATCH --partition=cpu-large

# Gate-4 G2d: evaluation2 rel-415 LBL fluxes ONLY (rayleigh generation +
# two LBL runs; no optimizer, no create/scale/find stages). Generated by
# gate4_g2d_eval2_rel415_flux_checkpoint.jl.
set -euo pipefail
if [ -z "${SLURM_JOB_ID:-}" ]; then
    echo "REFUSED: head-node execution is not permitted; submit via sbatch." >&2
    exit 64
fi

G4WORK=/shared/home/greg/ecckd-derived-flux-work/g4-init-generation
TESTCOPY="$G4WORK/testcopy-eval2"
WORKEVAL2="$G4WORK/work-eval2"
E2=/shared/home/greg/data/ckdmip/evaluation2

echo "=== G2d stage 0: preflight ==="
for b in ckdmip_lw ckdmip_sw ckdmip_tool; do
    test -x "/shared/home/greg/build/ckdmip-1.0/bin/$b" || { echo "MISSING binary $b" >&2; exit 65; }
done
test -s "/shared/home/greg/data/ckdmip/evaluation1/sw_spectra/ckdmip_ssi.h5" || { echo "MISSING evaluation1 SSI" >&2; exit 65; }
for band in lw sw; do
    for sp in h2o_present o3_present co2_present ch4_present n2o_present n2_constant o2_constant; do
        for chunk in 1-10 11-20 21-30 31-40 41-50; do
            test -s "$E2/${band}_spectra/ckdmip_evaluation2_${band}_spectra_${sp}_${chunk}.h5" || { echo "MISSING eval2 spectra: $band $sp $chunk (G2c incomplete?)" >&2; exit 65; }
        done
    done
done
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" || { echo "REFUSED: stale LW output exists" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "REFUSED: stale SW output exists" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" || { echo "REFUSED: stale LW install exists" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "REFUSED: stale SW install exists" >&2; exit 70; }
test ! -e "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "REFUSED: stale SW v14 install exists" >&2; exit 70; }
# partial-RAW guard (G2b lesson): wipe any prior quarantine work tree
if [ -e "$WORKEVAL2" ]; then
    echo "clearing pre-existing work-eval2 (partial-RAW guard)"
    find "$WORKEVAL2" -name 'RAW_*.h5' -printf '  partial: %p (%s B)\n' 2>/dev/null || true
    rm -rf "$WORKEVAL2"
fi

echo "=== G2d stage 1: eval2 SW rayleigh (upstream recipe; 5 chunks) ==="
# stale partials from any earlier killed job: report + remove (finals with
# the exact final name are NEVER touched; they only exist via the atomic mv)
find "$E2/sw_spectra" -maxdepth 1 -name 'ckdmip_evaluation2_sw_spectra_rayleigh_present_*.h5.partial.*' -printf 'removing stale partial: %p (%s B)\n' -delete 2>/dev/null || true
for chunk in 1-10 11-20 21-30 31-40 41-50; do
    R="$E2/sw_spectra/ckdmip_evaluation2_sw_spectra_rayleigh_present_$chunk.h5"
    if [ ! -s "$R" ]; then
        # atomic publication: generate to a job-scoped temp; only a
        # successfully completed file is mv'd to the final name, so a
        # mid-write kill can never leave a truncated FINAL that a retry
        # would wrongly reuse
        TMP="$R.partial.$SLURM_JOB_ID"
        rm -f "$TMP"
        /shared/home/greg/build/ckdmip-1.0/bin/ckdmip_tool --grid "$E2/sw_spectra/ckdmip_evaluation2_sw_spectra_h2o_present_$chunk.h5" --rayleigh -o "$TMP"
        test -s "$TMP" || { echo "MISSING rayleigh temp after generation: $chunk" >&2; exit 66; }
        mv "$TMP" "$R"
    fi
    test -s "$R" || { echo "MISSING rayleigh after generation: $chunk" >&2; exit 66; }
done
echo "rayleigh provenance:"
sha256sum "$E2/sw_spectra/"ckdmip_evaluation2_sw_spectra_rayleigh_present_*.h5

echo "=== G2d stage 2: isolated testcopy-eval2 from the PINNED artifact ==="
rm -rf "$TESTCOPY"
cp -r "/shared/home/greg/.julia/artifacts/7b210aef53e908cfe3c709945f0763c37ca82aaa/ecckd-6115f9b8e29a55cb0f48916857bdc77fec41badd/test" "$TESTCOPY"
cd "$TESTCOPY"
sed 's/@PACKAGE_VERSION@/1.2/g' version.h.in > version.h
sed -i \
  -e 's|^CKDMIP_DIR=.*|CKDMIP_DIR=/shared/home/greg/build/ckdmip-1.0|' \
  -e 's|^CKDMIP_DATA_DIR=.*|CKDMIP_DATA_DIR=/shared/home/greg/data/ckdmip|' \
  -e 's|^WORK_DIR=.*|WORK_DIR=$WORKEVAL2|' \
  -e 's|^BINDIR=.*|BINDIR=/shared/home/greg/ecckd-derived-flux-work/ecckd/src/ecckd|' \
  config.h
grep -E "^(CKDMIP_DIR|CKDMIP_DATA_DIR|WORK_DIR|BINDIR)=" config.h
# LW retarget: SET + explicit INDIR (INDIR is TRAINING-wired in the pristine
# script) + rel-415-only SCENARIOS
sed -i \
  -e 's|^SET=evaluation1$|SET=evaluation2|' \
  -e 's|^INDIR=$TRAINING_LW_SPECTRA_DIR$|INDIR=${CKDMIP_DATA_DIR}/evaluation2/lw_spectra|' \
  run_lw_lbl_evaluation.sh
sed -i -E "0,/^SCENARIOS=\"[^\"]*\"/s||SCENARIOS=\"rel-415\"|" run_lw_lbl_evaluation.sh
grep -E "^SET=|^INDIR=|^SCENARIOS=" run_lw_lbl_evaluation.sh
grep -qE "^SET=evaluation2$" run_lw_lbl_evaluation.sh || { echo "BAD edit: LW SET" >&2; exit 68; }
grep -qE "^SCENARIOS=\"rel-415\"$" run_lw_lbl_evaluation.sh || { echo "BAD edit: LW SCENARIOS" >&2; exit 68; }
# SW retarget: SET (fixes INDIR+OUTPREFIX) + rel-415 + rgb band edits (as G2a/G2b)
sed -i \
  -e 's|^SET=evaluation1$|SET=evaluation2|' \
  -e 's|^BANDCODE=fluxes$|BANDCODE=fluxes-rgb|' \
  -e 's|^band_wavenumber1(1:13)|!band_wavenumber1(1:13)|' \
  -e 's|^band_wavenumber2(1:13)|!band_wavenumber2(1:13)|' \
  -e 's|^!band_wavenumber1(1:9) = 250, 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750,|band_wavenumber1(1:9) = 250, 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750,|' \
  -e 's|^!band_wavenumber2(1:9) = 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750, 50000,|band_wavenumber2(1:9) = 2500, 4000, 8000, 14300, 16650, 20000, 25000, 31750, 50000,|' \
  run_sw_lbl_evaluation.sh
sed -i -E "0,/^SCENARIOS=\"[^\"]*\"/s||SCENARIOS=\"rel-415\"|" run_sw_lbl_evaluation.sh
grep -E "^SET=|^SCENARIOS=|^BANDCODE=|^band_wavenumber" run_sw_lbl_evaluation.sh
grep -qE "^SET=evaluation2$" run_sw_lbl_evaluation.sh || { echo "BAD edit: SW SET" >&2; exit 68; }
grep -qE "^BANDCODE=fluxes-rgb$" run_sw_lbl_evaluation.sh || { echo "BAD edit: SW BANDCODE" >&2; exit 68; }
test $(grep -cE "^band_wavenumber1" run_sw_lbl_evaluation.sh) -eq 1 || { echo "BAD edit: SW band grid" >&2; exit 68; }
# pipeline parity (both scripts): no nco module, quieter, Julia concat, reuse-skip
sed -i '/^module load nco$/s/^/# /' run_lw_lbl_evaluation.sh run_sw_lbl_evaluation.sh
sed -i 's/iverbose = 3/iverbose = 1/g' run_lw_lbl_evaluation.sh run_sw_lbl_evaluation.sh
sed -i -E 's|ncrcat -O \$OUTFILES \$OUTFILE|julia --project=/shared/home/greg/Projects/AnalyticBandRadiation-platform/test /shared/home/greg/Projects/AnalyticBandRadiation-platform/validation/concat_ckdmip_flux_chunks.jl $OUTFILES $OUTFILE|' run_lw_lbl_evaluation.sh run_sw_lbl_evaluation.sh
sed -i '/OUTFILES="$OUTFILES $OUTFILE"/a\
\tif [ -s "$OUTFILE" ]\
\tthen\
\t    echo "*** REUSING $OUTFILE ***"\
\t    continue\
\tfi' run_lw_lbl_evaluation.sh run_sw_lbl_evaluation.sh

echo "=== G2d stage 3: LW rel-415 LBL evaluation ==="
bash run_lw_lbl_evaluation.sh
echo "=== G2d stage 4: SW rel-415 RGB LBL evaluation ==="
bash run_sw_lbl_evaluation.sh

echo "=== G2d stage 5: exact-2 output-presence gate (quarantine) ==="
test -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" || { echo "MISSING LW output" >&2; exit 71; }
test -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "MISSING SW output" >&2; exit 71; }

echo "=== G2d stage 6: install verified outputs into executor trees ==="
mkdir -p "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_lbl_fluxes" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_lbl_fluxes" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_lbl_fluxes"
install -m 0644 "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5"
install -m 0644 "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5"
install -m 0644 "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5"
cmp -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" || { echo "INSTALL IDENTITY MISMATCH lw" >&2; exit 72; }
cmp -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "INSTALL IDENTITY MISMATCH sw" >&2; exit 72; }
cmp -s "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" || { echo "INSTALL IDENTITY MISMATCH sw-v14" >&2; exit 72; }

echo "=== G2d outputs ==="
sha256sum "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-eval2/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/lw_lbl_fluxes/ckdmip_evaluation2_lw_fluxes_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5" "/shared/home/greg/ecckd-derived-flux-work/g4-init-generation/work-v14/sw_lbl_fluxes/ckdmip_evaluation2_sw_fluxes-rgb_rel-415.h5"
echo "=== G2d done rc=$? $(date -u +%FT%TZ) ==="
